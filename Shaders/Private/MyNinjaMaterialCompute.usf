#include "/Engine/Private/Common.ush"

COMPILER_ALLOW_CS_DERIVATIVES

#include "/Engine/Generated/Material.ush"

int2 OutputExtent;
RWTexture2D<float4> OutputTexture;

[numthreads(THREADGROUP_SIZE_X, THREADGROUP_SIZE_Y, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const uint2 Pixel = DispatchThreadId.xy;
	if (any(Pixel >= uint2(OutputExtent)))
	{
		return;
	}

	ResolvedView = ResolveView();
	const float2 PixelCenter = float2(Pixel) + 0.5f;
	const float2 UV = PixelCenter / float2(OutputExtent);
	const float4 SvPosition = float4(PixelCenter, 0.0f, 1.0f);

	FMaterialPixelParameters MaterialParameters = MakeInitializedMaterialPixelParameters();
#if NUM_TEX_COORD_INTERPOLATORS
	UNROLL
	for (int CoordinateIndex = 0; CoordinateIndex < NUM_TEX_COORD_INTERPOLATORS; ++CoordinateIndex)
	{
		MaterialParameters.TexCoords[CoordinateIndex] = UV;
	}
#endif
	MaterialParameters.VertexColor = 1.0f;
	MaterialParameters.Particle.Color = 1.0f;

	FPixelMaterialInputs PixelMaterialInputs;
	CalcMaterialParametersEx(
		MaterialParameters,
		PixelMaterialInputs,
		SvPosition,
		SvPositionToResolvedScreenPosition(SvPosition),
		true,
		float3(PixelCenter, 0.0f),
		float3(PixelCenter, 0.0f));

	const float4 Source = float4(
		GetMaterialEmissive(PixelMaterialInputs),
		GetMaterialOpacity(PixelMaterialInputs));

#if MATERIALBLENDING_TRANSLUCENT
	const float4 Destination = OutputTexture[Pixel];
	OutputTexture[Pixel] = float4(
		Source.rgb * Source.a + Destination.rgb * (1.0f - Source.a),
		Destination.a * (1.0f - Source.a));
#elif MATERIALBLENDING_ADDITIVE
	const float4 Destination = OutputTexture[Pixel];
	OutputTexture[Pixel] = float4(
		Source.rgb + Destination.rgb,
		Destination.a * (1.0f - Source.a));
#else
	OutputTexture[Pixel] = float4(Source.rgb, 0.0f);
#endif
}
